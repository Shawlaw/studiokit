{
  "schemaVersion": 1,
  "fixturePack": "arcade-0.23-career-ui",
  "status": "frozen-for-T15",
  "contentPolicy": {
    "syntheticOnly": true,
    "spoilerFree": true,
    "productionVisible": false,
    "qaOnly": true,
    "rules": [
      "文本均为私有 QA 合成内容，不得复制到 apps/arcade/career/content 或正式页面。",
      "业务映射 ID（clueId/gameId/professionId/commissionId/toolId）必须来自真实 registry / clues / commissions / world-work / bridge catalog 映射；actionId 是 QA stub 名，仅按 ADR 约定注入函数，不是业务映射 ID。未知业务 ID 视为夹具错误。",
      "不复制外部原型包中的示例人物、示例物件、示例任务名或示例分数。",
      "若接入 dev/test 路由，路由必须在正式构建中不可达，且不留页面内调试入口。"
    ]
  },
  "sources": {
    "registry": "apps/arcade/career/content/registry.json",
    "clues": "apps/arcade/career/content/clues.json",
    "commissions": "apps/arcade/career/content/commissions.json",
    "worldWork": "apps/arcade/career/content/world-work.json",
    "contentVersion": "0.18.0"
  },
  "actionStubConvention": {
    "actionIdField": "id",
    "callable": "onClick",
    "qaOnly": true,
    "resolver": "qaActionStub(action.id)",
    "defaultStub": "记录一次调用并返回 { ok: true }",
    "busyAssertion": "第一次调用未 settle 前重复点击不得再调用 stub",
    "disabledAssertion": "disabled 动作点击后 stub 调用数必须为 0",
    "note": "JSON 不序列化函数；T15 QA 工具按 actionId 注入 onClick stub，产品组件仍收到真实函数。"
  },
  "toolIdMap": [
    { "toolId": "wallet", "label": "钱包", "icon": "wallet", "actionId": "openReceipt" },
    { "toolId": "shop", "label": "商店", "icon": "store", "actionId": "openMarket", "note": "store 只是线性图标名，不是 toolId 或可见标签。" },
    { "toolId": "workshop", "label": "工作台", "icon": "tool", "actionId": "openWorkshop" },
    { "toolId": "hangar", "label": "机库", "icon": "tool", "actionId": "openHangar" }
  ],
  "toolRenderOrder": ["wallet", "shop", "workshop", "hangar"],
  "clueDerivation": {
    "source": "bridge.renderClue({ clue, onOpen, host, placement, anchor, state })",
    "title": "ambientLabel || title",
    "teaser": "ambientText || ''",
    "gameId": "clue.gameId，必须匹配 registry.games",
    "professionId": "invitationForClue(clueId)?.professionId || registry 中该 game 的唯一 professionId；仅内部，不显示",
    "iconByFamily": { "record": "mail", "signal": "scroll", "bio": "gem", "industrial": "pick", "route": "chevron" },
    "iconByState": { "recoverable": "mail" },
    "actionLabel": { "glimpsed": "仔细看看", "recoverable": "clue.letter.actionLabel || 按地址投递", "read": "查看这封信" },
    "state": "state.clues[clueId] 与 openedAt 派生 hidden/glimpsed/read；recoverable 另需 !openedAt && !portSeenAt && stage∈{GLIMPSED,CURIOUS} && 存在 openedAt 线索"
  },
  "storyMessageProducer": {
    "contentSource": "apps/arcade/career/content/narrative-shards/shard-01.json ... shard-04.json（T14 独占新增）",
    "selector": "T12 adapter 选零条或一条；professionId 必须在 view.professions 中",
    "injection": "lead 串行集成的 bridge.careerView() 在 projectCareerView() 之后注入；多条按时序/ID 取一条，硬上限 1",
    "consumerShape": ["label", "text", "from", "at"],
    "forbidden": ["未接受职业", "storyFeedback.nextStep", "NPC/章节目录直读"]
  },
